# Copy these settings into your existing backend/.env; do not replace existing secrets.
# This is a local DEVELOPMENT-only test mode, never for deployment.
RAIDER_MODE=sandbox-test
RAIDER_SANDBOX_WRITE_ENABLED=YES
RAIDER_SANDBOX_TEST_REQUESTOR_UID=REPLACE_WITH_SANDBOX_PERSON_UID
RAIDER_SANDBOX_TEST_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

TDX_BASE_URL=https://supportdesk.grcc.edu/SBTDWebAPI
TDX_TICKET_APP_ID=28
TDX_ASSET_APP_ID=40
TDX_TYPE_ID=REPLACE_WITH_VALID_ID
TDX_STATUS_ID=REPLACE_WITH_VALID_ID
TDX_PRIORITY_ID=REPLACE_WITH_VALID_ID
TDX_FORM_ID=REPLACE_WITH_VALID_ID
# Optional, only if appropriate to the test requestor:
# TDX_ACCOUNT_ID=REPLACE_WITH_VALID_ID
TDX_TICKET_URL_BASE=https://supportdesk.grcc.edu/TDNext/Apps/28/Tickets/TicketDet.aspx?TicketID=
# Keep your existing TDX_BEID and TDX_WS_KEY in backend/.env.
