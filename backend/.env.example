# Local demo (no TeamDynamix calls):
PORT=8789
RAIDER_MODE=demo

# For real GRCC Sandbox buildings and rooms, set RAIDER_MODE=sandbox-readonly
# This mode never creates tickets and binds to 127.0.0.1 only.
# RAIDER_MODE=sandbox-readonly
# TDX_BASE_URL=https://supportdesk.grcc.edu/SBTDWebAPI
# TDX_BEID=
# TDX_WS_KEY=

# Future trusted production integration only; DO NOT enable without a
# real authenticated gateway that strips and sets identity headers.
# RAIDER_MODE=production
# IDENTITY_INTEGRATION=trusted-proxy
# TRUSTED_PROXY_ENABLED=true
# TDX_TICKET_APP_ID=28
# TDX_ASSET_APP_ID=40
# TDX_TYPE_ID=
# TDX_STATUS_ID=
# TDX_PRIORITY_ID=
# TDX_FORM_ID=
