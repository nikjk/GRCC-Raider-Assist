# Default: demo accepts requests locally but never creates tickets.
PORT=8789
RAIDER_MODE=demo
# Set to production ONLY behind a hardened identity-enforcing proxy.
# RAIDER_MODE=production
# IDENTITY_INTEGRATION=trusted-proxy
# TRUSTED_PROXY_ENABLED=true
# See docs/SECURITY.md; the raw server MUST NOT be reachable by clients.
# TDX_BASE_URL=https://supportdesk.grcc.edu/SBTDWebAPI
# TDX_BEID=
# TDX_WS_KEY=
# TDX_TICKET_APP_ID=28
# TDX_ASSET_APP_ID=40
# TDX_TYPE_ID=
# TDX_STATUS_ID=
# TDX_PRIORITY_ID=
# TDX_FORM_ID=
# TDX_ACCOUNT_ID=
# TDX_TICKET_URL_BASE=https://supportdesk.grcc.edu/TDNext/Apps/28/Tickets/TicketDet.aspx?TicketID=
